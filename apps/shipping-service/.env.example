NODE_ENV=development
PORT=3008

# Neon PostgreSQL. Create a `shipping_db` project and paste the connection
# string into apps/shipping-service/.env — NEVER into this file, which is
# committed. Note the mismatch documented in docs/HANDOFF.md §5: the Neon
# *project* is named shipping_db, but the database inside it is Neon's default
# `neondb`.
#
#   DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require
DATABASE_URL=

# The currency rates are quoted in. Nothing here is multi-currency until M11;
# a rate whose currency differs from the basket's is a seeding mistake, not a
# supported case.
SHIPPING_CURRENCY=USD

# Not used by the scaffold. Shipments are created by consuming `order.confirmed`
# and the lifecycle publishes its own events, both of which arrive at step 7 of
# docs/M10_SHIPPING_PLAN.md §13 — the settings are here so the compose block and
# the deployment configs do not have to change again when they do.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=commerce.events
RABBITMQ_QUEUE=shipping-service

# Must match the gateway. Generate with: openssl rand -base64 48
# Identity arrives as a gateway-verified header, so this is not needed to rate a
# basket — but it is kept identical everywhere so the service can verify tokens
# itself if that ever changes.
JWT_SECRET=
