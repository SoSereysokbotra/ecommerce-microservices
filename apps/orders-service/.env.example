NODE_ENV=development
PORT=3004

# Neon PostgreSQL. Create an `orders_db` project/database and paste the
# connection string into apps/orders-service/.env — NEVER into this file.
#
#   DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require
DATABASE_URL=

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=commerce.events
RABBITMQ_QUEUE=orders-service
REDIS_URL=redis://redis:6379

# M2 calls these synchronously. M3 replaces them with events.
CATALOG_SERVICE_URL=http://catalog-service:3002
INVENTORY_SERVICE_URL=http://inventory-service:3003
PAYMENTS_SERVICE_URL=http://payments-service:3005

JWT_SECRET=
