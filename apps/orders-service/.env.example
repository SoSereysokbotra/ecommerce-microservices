NODE_ENV=development
PORT=3004

# Neon PostgreSQL. Create an `orders_db` project/database and paste the
# connection string into apps/orders-service/.env — NEVER into this file.
#
#   DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require
DATABASE_URL=

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=commerce.events
RABBITMQ_QUEUE=orders-service
REDIS_URL=redis://redis:6379

# M3 replaced the state-changing calls to these with events.
INVENTORY_SERVICE_URL=http://inventory-service:3003
PAYMENTS_SERVICE_URL=http://payments-service:3005

# The one synchronous call orders still makes. M8 removed CATALOG_SERVICE_URL:
# orders no longer prices baskets itself, so it no longer talks to catalog.
PRICING_SERVICE_URL=http://pricing-service:3007

JWT_SECRET=

# M10: a saved delivery address is read from here at checkout, so the tax
# destination comes from a row the customer owns rather than from the request.
USERS_SERVICE_URL=http://users-service:3001
USERS_TIMEOUT_MS=3000
