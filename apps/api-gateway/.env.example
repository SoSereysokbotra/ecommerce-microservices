NODE_ENV=development
PORT=3000

# Generate with: openssl rand -base64 48
# Must match every service that validates tokens.
JWT_SECRET=

REDIS_URL=redis://redis:6379

UPSTREAM_TIMEOUT_MS=5000
UPSTREAM_RETRIES=2

USERS_SERVICE_URL=http://users-service:3001
CATALOG_SERVICE_URL=http://catalog-service:3002
INVENTORY_SERVICE_URL=http://inventory-service:3003
ORDERS_SERVICE_URL=http://orders-service:3004
PAYMENTS_SERVICE_URL=http://payments-service:3005

# Gateway rate limit. Defaults to 100 requests per 60s per address, which is a
# production posture — the Playwright suite needs a much higher ceiling.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
