{
  "name": "payments-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build payments-service",
    "start:dev": "ts-node --transpile-only -r ./register-node-path.js -r tsconfig-paths/register src/main.ts",
    "start:prod": "node dist/apps/payments-service/src/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest"
  },
  "dependencies": {
    "@libs/common": "file:../../libs/common",
    "@libs/rabbitmq": "file:../../libs/rabbitmq",
    "@libs/shared-types": "file:../../libs/shared-types",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.1",
    "axios": "^1.7.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/supertest": "^7.2.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@nestjs/common$": "<rootDir>/node_modules/@nestjs/common",
      "^@nestjs/core$": "<rootDir>/node_modules/@nestjs/core",
      "^@libs/shared-types(|/.*)$": "<rootDir>/../../libs/shared-types/src$1",
      "^@libs/common(|/.*)$": "<rootDir>/../../libs/common/src$1",
      "^@libs/rabbitmq(|/.*)$": "<rootDir>/../../libs/rabbitmq/src$1"
    }
  }
}
