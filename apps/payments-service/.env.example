NODE_ENV=development
PORT=3005

# Neon PostgreSQL. Create a `payments_db` project and paste the connection
# string into apps/payments-service/.env — NEVER into this file.
DATABASE_URL=

# Stripe TEST mode only. https://dashboard.stripe.com/test/apikeys
# The service refuses to start with a live key (sk_live_...).
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:3005/api/v1/payments/webhook`,
# or from the webhook endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=commerce.events
RABBITMQ_QUEUE=payments-service
REDIS_URL=redis://redis:6379

JWT_SECRET=
