NODE_ENV=development
PORT=3006

# Neon PostgreSQL. Create a `cart_db` project and paste the connection string
# into apps/cart-service/.env — NEVER into this file, which is committed.
#
#   DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require
DATABASE_URL=

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=commerce.events
RABBITMQ_QUEUE=cart-service

# Guest carts live here, not in Postgres. Unlike every other service, this one
# actually uses Redis — see docs/M7_CART_PLAN.md §1.
REDIS_URL=redis://redis:6379

# Must match the gateway. Generate with: openssl rand -base64 48
JWT_SECRET=

# Read-only, to cap merged quantities at what is actually in stock.
INVENTORY_SERVICE_URL=http://inventory-service:3003

# Guest carts expire on their own via Redis TTL; user carts need the sweep.
CART_GUEST_TTL_DAYS=30
CART_ABANDON_AFTER_DAYS=7
