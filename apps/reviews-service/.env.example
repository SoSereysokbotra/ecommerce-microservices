NODE_ENV=development
PORT=3010

# Neon PostgreSQL. Create a `reviews_db` project and paste the connection
# string into apps/reviews-service/.env — NEVER into this file, which is
# committed. Note the mismatch documented in docs/HANDOFF.md §5: the Neon
# *project* is named reviews_db, but the database inside it is Neon's default
# `neondb`.
#
#   DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require
DATABASE_URL=

# `order.confirmed` in (who may review what); `product.rating_changed` out
# (the average, for search-service's index). Both used from the first commit.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=commerce.events
RABBITMQ_QUEUE=reviews-service

# A review shows an author name. The gateway forwards an id, not a name, and
# the browser cannot be trusted to supply one — so the name is read from
# users-service and snapshotted onto the review.
USERS_SERVICE_URL=http://users-service:3001

# Must match the gateway. Generate with: openssl rand -base64 48
JWT_SECRET=
