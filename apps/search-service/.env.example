NODE_ENV=development
PORT=3009

# There is deliberately NO DATABASE_URL here. search-service owns a read model
# in OpenSearch that is built only by consuming catalog's events, and can be
# thrown away and rebuilt from them. A database connection string of any kind
# would be a way to bypass the bus — see docs/M12_SEARCH_PLAN.md §4.
OPENSEARCH_URL=http://opensearch:9200

# The queue binds `product.*` and `category.*`. The consumer arrives at step 3
# of docs/M12_SEARCH_PLAN.md §11; the binding is declared from the scaffold so
# events published before the consumer exists are queued, not dropped.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=commerce.events
RABBITMQ_QUEUE=search-service

# Must match the gateway. Generate with: openssl rand -base64 48
# Search is public and reads nothing per-user, but the secret is kept identical
# everywhere so the admin endpoint can verify a token when it arrives.
JWT_SECRET=
