NODE_ENV=development
PORT=3007

# Neon PostgreSQL. Create a `pricing_db` project and paste the connection string
# into apps/pricing-service/.env — NEVER into this file, which is committed.
# Note the mismatch documented in docs/HANDOFF.md §5: the Neon *project* is
# named pricing_db, but the database inside it is Neon's default `neondb`.
#
#   DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require
DATABASE_URL=

# M9: pricing joined the event system. M8 deliberately gave this service no
# broker at all — a quote changes no state — but a coupon redemption is state and
# has to be released when the order holding it is cancelled.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=commerce.events
RABBITMQ_QUEUE=pricing-service

# Prices and categories are read from here. The one cross-service call this
# service makes, and a read before anything commits, so a failure rejects the
# request cleanly.
CATALOG_SERVICE_URL=http://catalog-service:3002
CATALOG_TIMEOUT_MS=3000

# M10: shipping cost is folded into the quote here, so that exactly one thing
# computes a total. See docs/M10_SHIPPING_PLAN.md section 4.
SHIPPING_SERVICE_URL=http://shipping-service:3008
SHIPPING_TIMEOUT_MS=3000

# Where a quote is taxed when the caller does not say. Addresses arrive in M10;
# until then the destination travels on the request and this is the fallback.
DEFAULT_TAX_COUNTRY=US
DEFAULT_TAX_REGION=CA

# Must match the gateway. Generate with: openssl rand -base64 48
# Not needed to price a basket — identity arrives as a gateway-verified header —
# but kept identical everywhere so the service can verify tokens itself if that
# ever changes.
JWT_SECRET=

# M11: exchange rates.
#
# FX_PROVIDER_URL is unset on purpose — this project has no FX API key, and the
# milestone's content is the pattern (append-only log, newest wins, rate frozen
# at purchase) rather than the HTTP call. Unset, the seeded rates stand and the
# refresh job does not start. Point it at a provider returning
# { base, rates: { EUR: 0.925, ... } } and it works.
FX_PROVIDER_URL=
FX_PROVIDER_TIMEOUT_MS=5000
FX_REFRESH_MS=3600000
FX_BASE_CURRENCY=USD

# How old a rate may be before FxService warns while still using it. A stale
# rate prices a basket slightly wrong; no rate prices nothing.
FX_STALE_AFTER_MS=93600000
