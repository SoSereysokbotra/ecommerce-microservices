NODE_ENV=development
PORT=3001

# Neon PostgreSQL. Each service owns its own database.
# Create one at https://console.neon.tech, then paste the connection string
# into apps/users-service/.env — NEVER into this file, which is committed.
#
#   DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/users_db?sslmode=require
#
# SSL is enabled automatically for *.neon.tech hosts.
DATABASE_URL=

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=commerce.events
RABBITMQ_QUEUE=users-service
REDIS_URL=redis://redis:6379

# Generate with: openssl rand -base64 48
# The service refuses to start if this is unset.
JWT_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d
