NODE_ENV=development
PORT=3003

# Neon PostgreSQL. Create a `inventory_db` database and paste the connection
# string into apps/inventory-service/.env — NEVER into this file, which is committed.
#
#   DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/inventory_db?sslmode=require
DATABASE_URL=

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=commerce.events
RABBITMQ_QUEUE=inventory-service
REDIS_URL=redis://redis:6379

# Must match the gateway. Generate with: openssl rand -base64 48
JWT_SECRET=
