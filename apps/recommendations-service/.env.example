NODE_ENV=development
PORT=3012

# Neon PostgreSQL. Create a `recommendations_db` project and paste the connection
# string into apps/recommendations-service/.env — NEVER into this file, which is
# committed. Note the mismatch documented in docs/HANDOFF.md §5: the Neon
# *project* is named recommendations_db, but the database inside it is Neon's default
# `neondb`.
#
#   DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/neondb?sslmode=require
DATABASE_URL=

# `order.confirmed` in (items purchased); `order.co_purchase_replay` in (backfill).
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=commerce.events
RABBITMQ_QUEUE=recommendations-service

# Must match the gateway. Generate with: openssl rand -base64 48
JWT_SECRET=
