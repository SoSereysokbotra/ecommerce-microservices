{
  "components": {
    "schemas": {
      "DispatchShipmentDto": {
        "properties": {
          "carrier": {
            "example": "DHL",
            "type": "string"
          },
          "trackingCode": {
            "example": "JD0002210123456789",
            "type": "string"
          }
        },
        "type": "object"
      },
      "RateDestinationDto": {
        "properties": {
          "country": {
            "description": "ISO 3166-1 alpha-2.",
            "example": "US",
            "type": "string"
          },
          "region": {
            "description": "State or province code.",
            "example": "CA",
            "type": "string"
          }
        },
        "required": [
          "country"
        ],
        "type": "object"
      },
      "RateOptionDto": {
        "properties": {
          "code": {
            "example": "standard",
            "type": "string"
          },
          "costMinor": {
            "description": "What this costs for this basket. Zero when free applied.",
            "type": "number"
          },
          "currency": {
            "example": "USD",
            "type": "string"
          },
          "freeApplied": {
            "description": "True when a free-shipping threshold zeroed a real price.",
            "type": "boolean"
          },
          "listPriceMinor": {
            "description": "The band price before any threshold — for showing “was $5.99”.",
            "type": "number"
          },
          "name": {
            "example": "Standard (3–5 days)",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "costMinor",
          "freeApplied",
          "listPriceMinor",
          "currency"
        ],
        "type": "object"
      },
      "RateRequestDto": {
        "properties": {
          "destination": {
            "$ref": "#/components/schemas/RateDestinationDto"
          },
          "subtotalMinor": {
            "description": "Discounted subtotal, integer minor units.",
            "example": 4999,
            "type": "number"
          },
          "weightGrams": {
            "description": "Total basket weight in grams. Zero is valid.",
            "example": 1200,
            "type": "number"
          }
        },
        "required": [
          "destination",
          "weightGrams",
          "subtotalMinor"
        ],
        "type": "object"
      },
      "RateResponseDto": {
        "properties": {
          "cheapestCode": {
            "description": "What applies when the caller names no service level. Null when none do.",
            "nullable": true,
            "type": "object"
          },
          "options": {
            "description": "Cheapest first, ties by code. Empty when nothing ships to this destination.",
            "items": {
              "$ref": "#/components/schemas/RateOptionDto"
            },
            "type": "array"
          },
          "weightGrams": {
            "type": "number"
          },
          "zone": {
            "description": "Null when no zone covers this destination — the shop does not ship there.",
            "example": "US-CA",
            "nullable": true,
            "type": "object"
          }
        },
        "required": [
          "weightGrams",
          "options"
        ],
        "type": "object"
      },
      "ShipmentAddressDto": {
        "properties": {
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "line1": {
            "type": "string"
          },
          "line2": {
            "nullable": true,
            "type": "object"
          },
          "phone": {
            "nullable": true,
            "type": "object"
          },
          "postcode": {
            "nullable": true,
            "type": "object"
          },
          "recipient": {
            "type": "string"
          },
          "region": {
            "nullable": true,
            "type": "object"
          }
        },
        "required": [
          "recipient",
          "line1",
          "city",
          "country"
        ],
        "type": "object"
      },
      "ShipmentResponseDto": {
        "properties": {
          "address": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ShipmentAddressDto"
              }
            ],
            "nullable": true
          },
          "carrier": {
            "nullable": true,
            "type": "object"
          },
          "costMinor": {
            "description": "What delivery cost. Zero when it was free.",
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "deliveredAt": {
            "nullable": true,
            "type": "object"
          },
          "dispatchedAt": {
            "nullable": true,
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "rateCode": {
            "description": "Service level charged for.",
            "nullable": true,
            "type": "object"
          },
          "status": {
            "enum": [
              "pending",
              "dispatched",
              "delivered"
            ],
            "type": "string"
          },
          "trackingCode": {
            "nullable": true,
            "type": "object"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "weightG": {
            "description": "What it was rated on, in grams.",
            "type": "number"
          }
        },
        "required": [
          "id",
          "orderId",
          "customerId",
          "status",
          "costMinor",
          "weightG",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Rates by weight and zone, and the shipment lifecycle",
    "title": "Shipping Service",
    "version": "1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "AppController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "operationId": "AppController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/shipping/rates": {
      "post": {
        "operationId": "RatesController_rates",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RateRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Price delivery of a basket by weight and destination",
        "tags": [
          "shipping"
        ]
      }
    },
    "/api/v1/shipping/shipments/{id}/deliver": {
      "post": {
        "operationId": "ShipmentsController_deliver",
        "parameters": [
          {
            "description": "Set by the gateway from the verified JWT.",
            "in": "header",
            "name": "x-user-id",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Mark a parcel delivered (staff)",
        "tags": [
          "shipments"
        ]
      }
    },
    "/api/v1/shipping/shipments/{id}/dispatch": {
      "post": {
        "operationId": "ShipmentsController_dispatch",
        "parameters": [
          {
            "description": "Set by the gateway from the verified JWT.",
            "in": "header",
            "name": "x-user-id",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DispatchShipmentDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Hand a parcel to the carrier (staff)",
        "tags": [
          "shipments"
        ]
      }
    },
    "/api/v1/shipping/shipments/{orderId}": {
      "get": {
        "operationId": "ShipmentsController_findByOrder",
        "parameters": [
          {
            "description": "Set by the gateway from the verified JWT.",
            "in": "header",
            "name": "x-user-id",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-user-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "orderId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "The delivery for one of my orders",
        "tags": [
          "shipments"
        ]
      }
    },
    "/api/v1/shipping/zones": {
      "get": {
        "operationId": "RatesController_zones",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Every shipping zone, highest priority first",
        "tags": [
          "shipping"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
