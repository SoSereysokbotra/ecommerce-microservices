{
  "components": {
    "schemas": {
      "CreateProductDto": {
        "properties": {
          "active": {
            "default": true,
            "type": "boolean"
          },
          "categoryId": {
            "type": "object"
          },
          "currency": {
            "example": "USD",
            "type": "string"
          },
          "description": {
            "type": "object"
          },
          "name": {
            "example": "Black T-Shirt (M)",
            "type": "string"
          },
          "priceMinor": {
            "description": "Integer minor units. 1999 = $19.99.",
            "example": 1999,
            "type": "number"
          },
          "sku": {
            "example": "TSH-BLK-M",
            "type": "string"
          },
          "slug": {
            "example": "black-t-shirt-medium",
            "type": "string"
          }
        },
        "required": [
          "sku",
          "slug",
          "name",
          "priceMinor",
          "currency"
        ],
        "type": "object"
      },
      "PaginatedProductsDto": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/ProductResponseDto"
            },
            "type": "array"
          },
          "nextCursor": {
            "description": "Pass as `cursor` to fetch the next page. Null on the last page.",
            "nullable": true,
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "ProductResponseDto": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "categoryId": {
            "nullable": true,
            "type": "object"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "description": {
            "nullable": true,
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "priceMinor": {
            "description": "Integer minor units.",
            "type": "number"
          },
          "sku": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "sku",
          "slug",
          "name",
          "priceMinor",
          "currency",
          "active",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "UpdateProductDto": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "categoryId": {
            "type": "object"
          },
          "currency": {
            "type": "string"
          },
          "description": {
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "priceMinor": {
            "description": "Integer minor units.",
            "type": "number"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Products and categories",
    "title": "Catalog Service",
    "version": "1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/catalog/categories": {
      "get": {
        "operationId": "CategoriesController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "List categories",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/catalog/products": {
      "get": {
        "operationId": "ProductsController_list",
        "parameters": [
          {
            "description": "Category slug or id.",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Omit to see only active products.",
            "in": "query",
            "name": "active",
            "required": false,
            "schema": {
              "default": true,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "type": "number"
            }
          },
          {
            "description": "Opaque cursor from a previous response.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedProductsDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "List products",
        "tags": [
          "catalog"
        ]
      },
      "post": {
        "operationId": "ProductsController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Create a product",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/catalog/products/{idOrSlug}": {
      "get": {
        "operationId": "ProductsController_findOne",
        "parameters": [
          {
            "in": "path",
            "name": "idOrSlug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Get one product by id or slug",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/catalog/products/{id}": {
      "patch": {
        "operationId": "ProductsController_update",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Update a product",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "AppController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "operationId": "AppController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
