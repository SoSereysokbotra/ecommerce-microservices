{
  "components": {
    "schemas": {
      "AddCartItemDto": {
        "properties": {
          "productId": {
            "type": "string"
          },
          "qty": {
            "example": 1,
            "maximum": 999,
            "minimum": 1,
            "type": "number"
          }
        },
        "required": [
          "productId",
          "qty"
        ],
        "type": "object"
      },
      "CartLineDto": {
        "properties": {
          "productId": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          }
        },
        "required": [
          "productId",
          "qty"
        ],
        "type": "object"
      },
      "CartResponseDto": {
        "properties": {
          "cartToken": {
            "description": "A new guest cart token to store, or null once the guest cart has been merged and the client should forget it.",
            "nullable": true,
            "type": "object"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CartLineDto"
            },
            "type": "array"
          },
          "merged": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MergeSummaryDto"
              }
            ],
            "description": "Present only on the response that merged a guest cart in, so the UI can explain what changed."
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "MergeAdjustmentDto": {
        "properties": {
          "finalQty": {
            "description": "Zero means the line was dropped.",
            "type": "number"
          },
          "productId": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "capped_to_stock",
              "out_of_stock",
              "unavailable"
            ],
            "type": "string"
          },
          "requestedQty": {
            "type": "number"
          }
        },
        "required": [
          "productId",
          "requestedQty",
          "finalQty",
          "reason"
        ],
        "type": "object"
      },
      "MergeSummaryDto": {
        "properties": {
          "adjustments": {
            "items": {
              "$ref": "#/components/schemas/MergeAdjustmentDto"
            },
            "type": "array"
          }
        },
        "required": [
          "adjustments"
        ],
        "type": "object"
      },
      "SetCartItemQtyDto": {
        "properties": {
          "qty": {
            "description": "Zero removes the line.",
            "example": 2,
            "maximum": 999,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "qty"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Guest and signed-in carts, merged on login",
    "title": "Cart Service",
    "version": "1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/cart": {
      "delete": {
        "operationId": "CartController_clear",
        "parameters": [
          {
            "in": "header",
            "name": "x-user-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-cart-token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-correlation-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Empty the cart",
        "tags": [
          "cart"
        ]
      },
      "get": {
        "operationId": "CartController_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-user-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-cart-token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-correlation-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Get the current cart (guest or signed in)",
        "tags": [
          "cart"
        ]
      }
    },
    "/api/v1/cart/items": {
      "post": {
        "operationId": "CartController_add",
        "parameters": [
          {
            "in": "header",
            "name": "x-user-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-cart-token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-correlation-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddCartItemDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Add a product, accumulating onto any existing line",
        "tags": [
          "cart"
        ]
      }
    },
    "/api/v1/cart/items/{productId}": {
      "delete": {
        "operationId": "CartController_remove",
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-user-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-cart-token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-correlation-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Remove a line",
        "tags": [
          "cart"
        ]
      },
      "patch": {
        "operationId": "CartController_setQty",
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-user-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-cart-token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-correlation-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetCartItemQtyDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Set an absolute quantity; zero removes the line",
        "tags": [
          "cart"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "AppController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "operationId": "AppController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
