{
  "components": {
    "schemas": {
      "CreateOrderDto": {
        "properties": {
          "couponCode": {
            "example": "SAVE10USES",
            "type": "string"
          },
          "destination": {
            "$ref": "#/components/schemas/OrderDestinationDto"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderLineDto"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "OrderDestinationDto": {
        "properties": {
          "country": {
            "description": "ISO 3166-1 alpha-2.",
            "example": "US",
            "type": "string"
          },
          "region": {
            "description": "State or province code.",
            "example": "CA",
            "type": "string"
          }
        },
        "required": [
          "country"
        ],
        "type": "object"
      },
      "OrderItemResponseDto": {
        "properties": {
          "id": {
            "type": "string"
          },
          "lineDiscountMinor": {
            "description": "This line’s share of every discount that applied.",
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "sku": {
            "type": "string"
          },
          "taxMinor": {
            "description": "This line’s share of its tax group’s single rounded figure.",
            "type": "number"
          },
          "taxRateBp": {
            "description": "Basis points: 725 is 7.25%.",
            "type": "number"
          },
          "unitPriceMinor": {
            "description": "Integer minor units.",
            "type": "number"
          }
        },
        "required": [
          "id",
          "productId",
          "sku",
          "name",
          "qty",
          "unitPriceMinor",
          "lineDiscountMinor",
          "taxRateBp",
          "taxMinor"
        ],
        "type": "object"
      },
      "OrderLineDto": {
        "properties": {
          "productId": {
            "type": "string"
          },
          "qty": {
            "example": 2,
            "type": "number"
          }
        },
        "required": [
          "productId",
          "qty"
        ],
        "type": "object"
      },
      "OrderResponseDto": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "discountMinor": {
            "description": "What promotions took off, summed.",
            "type": "number"
          },
          "failureReason": {
            "nullable": true,
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemResponseDto"
            },
            "type": "array"
          },
          "status": {
            "enum": [
              "pending",
              "awaiting_payment",
              "confirmed",
              "cancelled",
              "failed"
            ],
            "type": "string"
          },
          "subtotalMinor": {
            "description": "The basket before anything was applied.",
            "type": "number"
          },
          "taxCountry": {
            "description": "Null for orders placed before M8.",
            "nullable": true,
            "type": "object"
          },
          "taxMinor": {
            "description": "Integer minor units.",
            "type": "number"
          },
          "taxRegion": {
            "nullable": true,
            "type": "object"
          },
          "totalMinor": {
            "description": "What the customer pays. Includes tax from M8.",
            "type": "number"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "customerId",
          "status",
          "currency",
          "subtotalMinor",
          "discountMinor",
          "taxMinor",
          "totalMinor",
          "items",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Order lifecycle",
    "title": "Orders Service",
    "version": "1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "AppController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/orders": {
      "get": {
        "operationId": "OrdersController_list",
        "parameters": [
          {
            "description": "Set by the gateway from the verified JWT.",
            "in": "header",
            "name": "x-user-id",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-user-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OrderResponseDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "List my orders",
        "tags": [
          "orders"
        ]
      },
      "post": {
        "operationId": "OrdersController_create",
        "parameters": [
          {
            "description": "Set by the gateway from the verified JWT.",
            "in": "header",
            "name": "x-user-id",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-user-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-correlation-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Place an order",
        "tags": [
          "orders"
        ]
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "operationId": "OrdersController_findOne",
        "parameters": [
          {
            "description": "Set by the gateway from the verified JWT.",
            "in": "header",
            "name": "x-user-id",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-user-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Get one of my orders",
        "tags": [
          "orders"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "operationId": "AppController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
