{
  "components": {
    "schemas": {
      "AddressResponseDto": {
        "properties": {
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "isDefault": {
            "type": "boolean"
          },
          "label": {
            "nullable": true,
            "type": "object"
          },
          "line1": {
            "type": "string"
          },
          "line2": {
            "nullable": true,
            "type": "object"
          },
          "phone": {
            "nullable": true,
            "type": "object"
          },
          "postcode": {
            "nullable": true,
            "type": "object"
          },
          "recipient": {
            "type": "string"
          },
          "region": {
            "nullable": true,
            "type": "object"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "userId",
          "recipient",
          "line1",
          "city",
          "country",
          "isDefault",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "CreateAddressDto": {
        "properties": {
          "city": {
            "example": "San Francisco",
            "type": "string"
          },
          "country": {
            "description": "ISO 3166-1 alpha-2.",
            "example": "US",
            "type": "string"
          },
          "isDefault": {
            "default": false,
            "description": "Make this the one checkout pre-selects.",
            "type": "boolean"
          },
          "label": {
            "example": "Home",
            "type": "object"
          },
          "line1": {
            "example": "12 Ocean Avenue",
            "type": "string"
          },
          "line2": {
            "example": "Apt 4",
            "type": "object"
          },
          "phone": {
            "example": "+1 415 555 0123",
            "type": "object"
          },
          "postcode": {
            "example": "94102",
            "type": "object"
          },
          "recipient": {
            "example": "Ada Lovelace",
            "type": "string"
          },
          "region": {
            "description": "State or province code.",
            "example": "CA",
            "type": "object"
          }
        },
        "required": [
          "recipient",
          "line1",
          "city",
          "country"
        ],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "RegisterDto": {
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "enum": [
              "customer",
              "staff",
              "admin"
            ],
            "type": "string"
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ],
        "type": "object"
      },
      "UpdateAddressDto": {
        "properties": {
          "city": {
            "example": "San Francisco",
            "type": "string"
          },
          "country": {
            "description": "ISO 3166-1 alpha-2.",
            "example": "US",
            "type": "string"
          },
