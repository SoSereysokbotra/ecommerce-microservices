{
  "components": {
    "schemas": {
      "AppliedDiscountResponseDto": {
        "properties": {
          "amountMinor": {
            "description": "Integer minor units.",
            "type": "number"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "amountMinor"
        ],
        "type": "object"
      },
      "CreateQuoteDto": {
        "properties": {
          "couponCode": {
            "example": "SAVE10USES",
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "destination": {
            "$ref": "#/components/schemas/DestinationDto"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/QuoteLineDto"
            },
            "type": "array"
          },
          "shippingRateCode": {
            "example": "standard",
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "CurrencyResponseDto": {
        "properties": {
          "code": {
            "description": "ISO 4217, upper case.",
            "example": "JPY",
            "type": "string"
          },
          "exponent": {
            "description": "Decimal places: 10^exponent minor units to one major unit. Two for USD and EUR, ZERO for JPY — which is why this is data and not a constant.",
            "example": 0,
            "type": "number"
          },
          "name": {
            "example": "Japanese Yen",
            "type": "string"
          }
        },
        "required": [
          "code",
          "exponent",
          "name"
        ],
        "type": "object"
      },
      "DestinationDto": {
        "properties": {
          "country": {
            "description": "ISO 3166-1 alpha-2.",
            "example": "US",
            "type": "string"
          },
          "region": {
            "description": "State or province code.",
            "example": "CA",
            "type": "string"
          }
        },
        "required": [
          "country"
        ],
        "type": "object"
      },
      "HoldCouponDto": {
        "properties": {
          "amountMinor": {
            "description": "What the coupon took off, in integer minor units.",
            "type": "number"
          },
          "code": {
            "example": "SAVE10USES",
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "orderId",
          "customerId",
          "amountMinor"
        ],
        "type": "object"
      },
      "QuoteCouponResponseDto": {
        "properties": {
          "amountMinor": {
            "description": "Integer minor units.",
            "type": "number"
          },
          "applied": {
            "description": "Whether it actually came off this basket.",
            "type": "boolean"
          },
          "code": {
            "type": "string"
          },
          "rejectedBecause": {
            "description": "Why it did not apply: expired, exhausted, per_customer_limit, and so on.",
            "nullable": true,
            "type": "object"
          }
        },
        "required": [
          "code",
          "applied",
          "amountMinor"
        ],
        "type": "object"
      },
      "QuoteLineDto": {
        "properties": {
          "productId": {
            "type": "string"
          },
          "qty": {
            "example": 2,
            "type": "number"
          }
        },
        "required": [
          "productId",
          "qty"
        ],
        "type": "object"
      },
      "QuoteLineResponseDto": {
        "properties": {
          "lineDiscountMinor": {
            "description": "This line’s share of every discount that applied.",
            "type": "number"
          },
          "lineSubtotalMinor": {
            "description": "Integer minor units.",
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "sku": {
            "type": "string"
          },
          "taxMinor": {
            "description": "This line’s share of its tax group’s single rounded figure.",
            "type": "number"
          },
          "taxRateBp": {
            "description": "Basis points: 725 is 7.25%.",
            "type": "number"
          },
          "taxableMinor": {
            "description": "Subtotal less discount — what tax is charged on.",
            "type": "number"
          },
          "unitPriceMinor": {
            "description": "Integer minor units.",
            "type": "number"
          }
        },
        "required": [
          "productId",
          "sku",
          "name",
          "qty",
          "unitPriceMinor",
          "lineSubtotalMinor",
          "lineDiscountMinor",
          "taxableMinor",
          "taxRateBp",
          "taxMinor"
        ],
        "type": "object"
      },
      "QuoteResponseDto": {
        "properties": {
          "appliedDiscounts": {
            "items": {
              "$ref": "#/components/schemas/AppliedDiscountResponseDto"
            },
            "type": "array"
          },
          "coupon": {
            "allOf": [
              {
                "$ref": "#/components/schemas/QuoteCouponResponseDto"
              }
            ],
            "nullable": true
          },
          "currency": {
            "type": "string"
          },
          "destination": {
            "$ref": "#/components/schemas/DestinationDto"
          },
          "discountMinor": {
            "type": "number"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/QuoteLineResponseDto"
            },
            "type": "array"
          },
          "netMinor": {
            "description": "The amount excluding tax.",
            "type": "number"
          },
          "shipping": {
            "allOf": [
              {
                "$ref": "#/components/schemas/QuoteShippingResponseDto"
              }
            ],
            "nullable": true
          },
          "shippingMinor": {
            "description": "Delivery as charged, same convention as subtotalMinor — in an inclusive-tax region it already contains its VAT. Zero when free or unpriced.",
            "type": "number"
          },
          "shippingTaxMinor": {
            "description": "Delivery’s share of taxMinor: an allocation of its tax group’s single rounded figure, never rounded on its own.",
            "type": "number"
          },
          "subtotalMinor": {
            "description": "Before any discount or tax.",
            "type": "number"
          },
          "taxBreakdown": {
            "description": "One entry per tax rate in the basket. Tax is rounded once per group, and this is that rounding made visible.",
            "items": {
              "$ref": "#/components/schemas/TaxGroupResponseDto"
            },
            "type": "array"
          },
          "taxMinor": {
            "type": "number"
          },
          "totalMinor": {
            "description": "What the customer pays. Includes shipping from M10.",
            "type": "number"
          }
        },
        "required": [
          "currency",
          "destination",
          "lines",
          "subtotalMinor",
          "discountMinor",
          "appliedDiscounts",
          "taxBreakdown",
          "taxMinor",
          "shippingMinor",
          "shippingTaxMinor",
          "netMinor",
          "totalMinor"
        ],
        "type": "object"
      },
      "QuoteShippingResponseDto": {
        "properties": {
          "options": {
            "description": "Cheapest first.",
            "items": {
              "$ref": "#/components/schemas/ShippingOptionResponseDto"
            },
            "type": "array"
          },
          "requestedCodeUnavailable": {
            "description": "True when a requested shippingRateCode is not on offer for this basket.",
            "type": "boolean"
          },
          "selectedCode": {
            "description": "The option folded into totalMinor. Cheapest, unless one was requested.",
            "nullable": true,
            "type": "object"
          },
          "weightGrams": {
            "description": "Summed from the basket’s product weights.",
            "type": "number"
          },
          "zone": {
            "description": "Null when no zone covers this destination — the shop does not ship there.",
            "example": "US-CA",
            "nullable": true,
            "type": "object"
          }
        },
        "required": [
          "weightGrams",
          "options",
          "requestedCodeUnavailable"
        ],
        "type": "object"
      },
      "ShippingOptionResponseDto": {
        "properties": {
          "code": {
            "example": "standard",
            "type": "string"
          },
          "costMinor": {
            "description": "What this option costs this basket. Zero when free applied.",
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "freeApplied": {
            "description": "True when a free-shipping threshold zeroed a real price.",
            "type": "boolean"
          },
          "listPriceMinor": {
            "description": "The band price before any threshold.",
            "type": "number"
          },
          "name": {
            "example": "Standard (3–5 days)",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "costMinor",
          "freeApplied",
          "listPriceMinor",
          "currency"
        ],
        "type": "object"
      },
      "TaxGroupResponseDto": {
        "properties": {
          "baseMinor": {
            "description": "Sum of the group’s taxable amounts, exact.",
            "type": "number"
          },
          "pricesIncludeTax": {
            "description": "Whether the price already contained this tax.",
            "type": "boolean"
          },
          "rateBp": {
            "description": "Basis points: 725 is 7.25%.",
            "type": "number"
          },
          "taxMinor": {
            "description": "Rounded exactly once, for the whole group.",
            "type": "number"
          }
        },
        "required": [
          "rateBp",
          "pricesIncludeTax",
          "baseMinor",
          "taxMinor"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Tax and discounts: what a basket actually costs",
    "title": "Pricing Service",
    "version": "1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "AppController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/pricing/coupons/hold": {
      "post": {
        "operationId": "CouponsController_hold",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HoldCouponDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Whether the use was granted, and why not if it was refused."
          }
        },
        "summary": "Claim one use of a coupon for an order",
        "tags": [
          "coupons"
        ]
      }
    },
    "/api/v1/pricing/coupons/release": {
      "post": {
        "operationId": "CouponsController_release",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Release a held coupon use for an order that was never created",
        "tags": [
          "coupons"
        ]
      }
    },
    "/api/v1/pricing/coupons/{code}": {
      "get": {
        "operationId": "CouponsController_validate",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Validate a coupon code without redeeming it",
        "tags": [
          "coupons"
        ]
      }
    },
    "/api/v1/pricing/currencies": {
      "get": {
        "operationId": "CurrencyController_list",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CurrencyResponseDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Every currency on offer, with its minor-unit exponent",
        "tags": [
          "pricing"
        ]
      }
    },
    "/api/v1/pricing/discounts": {
      "get": {
        "operationId": "PricingController_discounts",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Promotions currently active",
        "tags": [
          "pricing"
        ]
      }
    },
    "/api/v1/pricing/fx-rates": {
      "get": {
        "operationId": "CurrencyController_rates",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "The exchange rate in force for each pair",
        "tags": [
          "pricing"
        ]
      }
    },
    "/api/v1/pricing/quote": {
      "post": {
        "operationId": "PricingController_quote",
        "parameters": [
          {
            "in": "header",
            "name": "x-correlation-id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateQuoteDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponseDto"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Price a basket: subtotal, discounts, tax, total",
        "tags": [
          "pricing"
        ]
      }
    },
    "/api/v1/pricing/tax-rates": {
      "get": {
        "operationId": "PricingController_taxRates",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Every tax rule, most general first",
        "tags": [
          "pricing"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "operationId": "AppController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
